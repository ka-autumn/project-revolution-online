{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm --filter @revolution/client build",
  "outputDirectory": "packages/client/dist",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- packages/client packages/engine proxy.ts vercel.json package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json",
  "proxy": {
    "entrypoint": "proxy.ts"
  },
  "rewrites": [
    {
      "source": "/recipe/:key",
      "destination": "/index.html"
    }
  ]
}
